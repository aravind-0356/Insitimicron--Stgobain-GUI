# ============================================================
#  InsituMicron / Saint-Gobain Load Cell HMI - .gitignore
# ============================================================

# Runtime Logs
*.log
kiosk_status.log

# SQLite Databases & Backups
*.db
*.db.bak*

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
venv/
.env/
env/

# IDE & Editor Configurations
.idea/
.vscode/
.agents/
*.swp
*.swo

# OS Generated Files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Temporary & Export Files
*.tmp
exports/*.csv
exports/*.pdf
